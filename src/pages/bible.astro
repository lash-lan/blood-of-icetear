---
// The world bible, readable on the site and behind the same door as the
// atelier, the plan and the council. It is working material: it carries
// unsettled decisions and notes to self, so it is never public.
//
// The markdown lives at docs/world-bible.md and is the same file GitHub
// renders. Astro compiles it at build time, so nothing has to be copied or
// kept in step by hand, and the images beside it come through the asset
// pipeline on their own.
import { env } from 'cloudflare:workers';
import { ticketHolds, ticketFrom } from '../lib/session.js';
import { Content, getHeadings } from '../../docs/world-bible.md';

export const prerender = false;

const unlocked = await ticketHolds(env.ATELIER_SESSION_SECRET, ticketFrom(Astro.cookies));

const PROBLEMS = {
  wrong: 'That is not the password.',
  unconfigured: 'The password has not been set on the server yet.',
};
const problem = PROBLEMS[Astro.url.searchParams.get('e')] ?? '';

// Only the numbered sections go in the contents. The sub-headings inside them
// would run to well over a hundred entries.
const sections = getHeadings().filter((h) => h.depth === 2);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="robots" content="noindex, nofollow" />
  <title>World Bible</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,600;1,400&family=Inter:wght@400;600&display=swap" rel="stylesheet" />
  <style>
    :root {
      --ink: #ddd6cc;
      --dim: #9a9188;
      --faint: #6b645d;
      --bg: #14131a;
      --panel: #1b1a22;
      --rule: #2e2c36;
      --gold: #c9a44c;
    }
    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0;
      background: var(--bg);
      color: var(--ink);
      font-family: 'EB Garamond', Georgia, serif;
      font-size: 19px;
      line-height: 1.68;
    }

    /* The password gate, matching the other private pages. */
    .lock { min-height: 100dvh; display: grid; place-items: center; padding: 1.5rem; }
    .lock form {
      width: min(22rem, 100%);
      background: var(--panel);
      border: 1px solid var(--rule);
      border-radius: 0.6rem;
      padding: 1.6rem;
    }
    .lock h1 { margin: 0 0 1.1rem; font-size: 1.5rem; font-weight: 400; letter-spacing: 0.02em; }
    .lock label { display: block; font-family: Inter, system-ui, sans-serif; font-size: 0.78rem; color: var(--dim); margin-bottom: 0.35rem; }
    .lock input {
      width: 100%; padding: 0.6rem 0.7rem; font: inherit;
      background: #100f15; color: var(--ink);
      border: 1px solid var(--rule); border-radius: 0.35rem;
    }
    .lock button {
      margin-top: 1.1rem; width: 100%; padding: 0.6rem;
      font-family: Inter, system-ui, sans-serif; font-size: 0.9rem;
      background: var(--gold); color: #17140c; border: 0; border-radius: 0.35rem; cursor: pointer;
    }
    .problem { min-height: 1.2em; margin: 0.6rem 0 0; font-family: Inter, system-ui, sans-serif; font-size: 0.8rem; color: #d08a7a; }

    /* The reading view. */
    .shell { display: grid; grid-template-columns: 17rem minmax(0, 1fr); }
    .side {
      position: sticky; top: 0; align-self: start;
      height: 100dvh; overflow-y: auto;
      padding: 1.6rem 1.1rem 3rem;
      border-right: 1px solid var(--rule);
      background: var(--panel);
      font-family: Inter, system-ui, sans-serif;
      font-size: 0.8rem;
      line-height: 1.5;
    }
    .side .brand {
      font-family: 'EB Garamond', Georgia, serif;
      font-size: 1.35rem; margin: 0 0 0.2rem; font-weight: 400;
    }
    .side .note { color: var(--faint); margin: 0 0 1.4rem; font-size: 0.74rem; }
    .side a { display: block; padding: 0.3rem 0; color: var(--dim); text-decoration: none; border-bottom: 1px solid transparent; }
    .side a:hover { color: var(--gold); }

    .read { padding: 3rem 2.5rem 8rem; min-width: 0; }
    .read > :global(*) { max-width: 44rem; margin-inline: auto; }

    .read :global(h1) { font-size: 2.6rem; font-weight: 400; line-height: 1.15; margin: 0 auto 2rem; }
    .read :global(h2) {
      font-size: 1.9rem; font-weight: 400; line-height: 1.2;
      margin: 4.5rem auto 1.2rem; padding-top: 2.2rem;
      border-top: 1px solid var(--rule); scroll-margin-top: 1rem;
    }
    .read :global(h3) { font-size: 1.35rem; font-weight: 600; margin: 2.6rem auto 0.8rem; color: #efe7db; scroll-margin-top: 1rem; }
    .read :global(p) { margin: 0 auto 1.1rem; }
    .read :global(strong) { color: #fff6e6; font-weight: 600; }
    .read :global(em) { color: var(--dim); }
    .read :global(a) { color: var(--gold); }

    .read :global(blockquote) {
      margin: 1.6rem auto; padding: 0.2rem 0 0.2rem 1.3rem;
      border-left: 3px solid var(--gold); color: #e8dfd2; font-style: italic;
    }
    .read :global(blockquote p) { margin-bottom: 0.6rem; }
    .read :global(ul), .read :global(ol) { margin: 0 auto 1.2rem; padding-left: 1.4rem; }
    .read :global(li) { margin-bottom: 0.4rem; }
    .read :global(hr) { border: 0; border-top: 1px solid var(--rule); margin: 3rem auto; }
    .read :global(code) { font-size: 0.85em; background: #100f15; padding: 0.1em 0.35em; border-radius: 0.25em; color: #d8c89f; }

    /* Tables carry a great deal of this document, so they get room. */
    .read :global(table) {
      max-width: 60rem; width: 100%;
      border-collapse: collapse; margin: 1.6rem auto 2rem;
      font-family: Inter, system-ui, sans-serif; font-size: 0.86rem; line-height: 1.5;
      display: block; overflow-x: auto;
    }
    .read :global(th), .read :global(td) {
      border: 1px solid var(--rule); padding: 0.55rem 0.7rem;
      text-align: left; vertical-align: top;
    }
    .read :global(th) { background: #201e28; color: #efe7db; font-weight: 600; white-space: nowrap; }

    .read :global(img) {
      display: block; max-width: min(60rem, 100%); height: auto;
      margin: 2.2rem auto; border: 1px solid var(--rule); border-radius: 0.3rem;
    }

    @media (max-width: 60rem) {
      body { font-size: 18px; }
      .shell { grid-template-columns: 1fr; }
      .side {
        position: static; height: auto; border-right: 0;
        border-bottom: 1px solid var(--rule); padding: 1.2rem 1rem;
        max-height: 14rem;
      }
      .read { padding: 2rem 1rem 6rem; }
      .read :global(h1) { font-size: 2rem; }
      .read :global(h2) { font-size: 1.5rem; margin-top: 3rem; }
    }
  </style>
</head>
<body>

{!unlocked && (
  <div class="lock">
    <form method="POST" action="/api/login">
      <h1>World Bible</h1>
      <input type="hidden" name="next" value="/bible" />
      <div>
        <label for="p">Password</label>
        <input type="password" id="p" name="password" autocomplete="current-password" autofocus required />
      </div>
      <p class="problem">{problem}</p>
      <button type="submit">Enter</button>
    </form>
  </div>
)}

{unlocked && (
  <div class="shell">
    <nav class="side">
      <p class="brand">Archavalon</p>
      <p class="note">The world bible. Working material, not published lore.</p>
      {sections.map((h) => <a href={`#${h.slug}`}>{h.text}</a>)}
    </nav>
    <main class="read">
      <Content />
    </main>
  </div>
)}

</body>
</html>
