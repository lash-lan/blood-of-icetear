---
// The world bible, readable on the site by anyone who has the address.
//
// It has no password, on Lash's instruction, so a link can simply be sent to
// someone. It keeps noindex, so it will not turn up in a search for anyone who
// was not sent it, and it is deliberately not linked from the site's own
// navigation. Unlisted rather than secret.
//
// The markdown lives at docs/world-bible.md and is the same file GitHub
// renders. Astro compiles it at build time, so nothing has to be copied or
// kept in step by hand, and the images beside it come through the asset
// pipeline on their own.
import { Content, getHeadings } from '../../docs/world-bible.md';

// Only the numbered sections go in the contents. The sub-headings inside them
// would run to well over a hundred entries.
const sections = getHeadings().filter((h) => h.depth === 2);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="robots" content="noindex, nofollow" />
  <title>World Bible</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,600;1,400&family=Inter:wght@400;600&display=swap" rel="stylesheet" />
  <style>
    :root {
      --ink: #ddd6cc;
      --dim: #9a9188;
      --faint: #6b645d;
      --bg: #14131a;
      --panel: #1b1a22;
      --rule: #2e2c36;
      --gold: #c9a44c;
    }
    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0;
      background: var(--bg);
      color: var(--ink);
      font-family: 'EB Garamond', Georgia, serif;
      font-size: 19px;
      line-height: 1.68;
    }

    /* The reading view. */
    .shell { display: grid; grid-template-columns: 17rem minmax(0, 1fr); }
    .side {
      position: sticky; top: 0; align-self: start;
      height: 100dvh; overflow-y: auto;
      padding: 1.6rem 1.1rem 3rem;
      border-right: 1px solid var(--rule);
      background: var(--panel);
      font-family: Inter, system-ui, sans-serif;
      font-size: 0.8rem;
      line-height: 1.5;
    }
    .side .brand {
      font-family: 'EB Garamond', Georgia, serif;
      font-size: 1.35rem; margin: 0 0 0.2rem; font-weight: 400;
    }
    .side .note { color: var(--faint); margin: 0 0 1.4rem; font-size: 0.74rem; }
    .side a { display: block; padding: 0.3rem 0; color: var(--dim); text-decoration: none; border-bottom: 1px solid transparent; }
    .side a:hover { color: var(--gold); }

    .read { padding: 3rem 2.5rem 8rem; min-width: 0; }
    .read > :global(*) { max-width: 44rem; margin-inline: auto; }

    .read :global(h1) { font-size: 2.6rem; font-weight: 400; line-height: 1.15; margin: 0 auto 2rem; }
    .read :global(h2) {
      font-size: 1.9rem; font-weight: 400; line-height: 1.2;
      margin: 4.5rem auto 1.2rem; padding-top: 2.2rem;
      border-top: 1px solid var(--rule); scroll-margin-top: 1rem;
    }
    .read :global(h3) { font-size: 1.35rem; font-weight: 600; margin: 2.6rem auto 0.8rem; color: #efe7db; scroll-margin-top: 1rem; }
    .read :global(p) { margin: 0 auto 1.1rem; }
    .read :global(strong) { color: #fff6e6; font-weight: 600; }
    .read :global(em) { color: var(--dim); }
    .read :global(a) { color: var(--gold); }

    .read :global(blockquote) {
      margin: 1.6rem auto; padding: 0.2rem 0 0.2rem 1.3rem;
      border-left: 3px solid var(--gold); color: #e8dfd2; font-style: italic;
    }
    .read :global(blockquote p) { margin-bottom: 0.6rem; }
    .read :global(ul), .read :global(ol) { margin: 0 auto 1.2rem; padding-left: 1.4rem; }
    .read :global(li) { margin-bottom: 0.4rem; }
    .read :global(hr) { border: 0; border-top: 1px solid var(--rule); margin: 3rem auto; }
    .read :global(code) { font-size: 0.85em; background: #100f15; padding: 0.1em 0.35em; border-radius: 0.25em; color: #d8c89f; }

    /* Tables carry a great deal of this document, so they get room. */
    .read :global(table) {
      max-width: 60rem; width: 100%;
      border-collapse: collapse; margin: 1.6rem auto 2rem;
      font-family: Inter, system-ui, sans-serif; font-size: 0.86rem; line-height: 1.5;
      display: block; overflow-x: auto;
    }
    .read :global(th), .read :global(td) {
      border: 1px solid var(--rule); padding: 0.55rem 0.7rem;
      text-align: left; vertical-align: top;
    }
    .read :global(th) { background: #201e28; color: #efe7db; font-weight: 600; white-space: nowrap; }

    .read :global(img) {
      display: block; max-width: min(60rem, 100%); height: auto;
      margin: 2.2rem auto; border: 1px solid var(--rule); border-radius: 0.3rem;
    }

    /* The listen controls, and the block currently being read. */
    .bar {
      position: fixed; z-index: 20;
      right: 1.4rem; bottom: 1.4rem;
      display: flex; align-items: center; gap: 0.6rem;
      padding: 0.55rem 0.8rem;
      background: rgba(27, 26, 34, 0.94);
      border: 1px solid var(--rule); border-radius: 2rem;
      backdrop-filter: blur(6px);
      font-family: Inter, system-ui, sans-serif;
    }
    .bar button {
      font: inherit; font-size: 0.82rem;
      padding: 0.35rem 0.9rem; border-radius: 1.4rem; cursor: pointer;
      background: var(--gold); color: #17140c; border: 0;
    }
    .bar button#stop { background: transparent; color: var(--dim); border: 1px solid var(--rule); }
    .bar .where { font-size: 0.72rem; color: var(--faint); min-width: 5.5rem; }

    .read :global(.speaking) {
      background: rgba(201, 164, 76, 0.1);
      box-shadow: -0.9rem 0 0 rgba(201, 164, 76, 0.1), 0.9rem 0 0 rgba(201, 164, 76, 0.1);
      border-radius: 0.15rem;
    }
    .read :global(img.speaking), .read :global(table.speaking) {
      outline: 2px solid var(--gold); outline-offset: 0.4rem; background: none; box-shadow: none;
    }
    @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }

    @media (max-width: 60rem) {
      body { font-size: 18px; }
      .shell { grid-template-columns: 1fr; }
      .side {
        position: static; height: auto; border-right: 0;
        border-bottom: 1px solid var(--rule); padding: 1.2rem 1rem;
        max-height: 14rem;
      }
      .read { padding: 2rem 1rem 6rem; }
      .read :global(h1) { font-size: 2rem; }
      .read :global(h2) { font-size: 1.5rem; margin-top: 3rem; }
    }
  </style>
</head>
<body>

  <div class="shell">
    <nav class="side">
      <p class="brand">Archavalon</p>
      <p class="note">The world bible. Working material, not published lore.</p>
      {sections.map((h) => <a href={`#${h.slug}`}>{h.text}</a>)}
    </nav>
    <main class="read" id="read">
      <Content />
    </main>

    <div class="bar" id="bar" hidden>
      <button type="button" id="play">Listen</button>
      <button type="button" id="stop" hidden>Stop</button>
      <span class="where" id="where"></span>
    </div>
  </div>

<script is:inline>
  // Reads the page aloud, block by block, and holds on the things that are
  // meant to be looked at rather than heard.
  //
  // Images hold two seconds. Tables hold a little longer, scaled to how many
  // rows they have, because a table read aloud is gibberish but you still want
  // time to see it.
  //
  // This uses the browser's own voice. It is flat, and it is a placeholder for
  // the narration proper, but it means the mechanism works today and only the
  // sound has to be swapped later.
  (function () {
    var synth = window.speechSynthesis;
    var read = document.getElementById('read');
    var bar = document.getElementById('bar');
    if (!read || !bar || !synth) return;
    bar.hidden = false;

    var playBtn = document.getElementById('play');
    var stopBtn = document.getElementById('stop');
    var where = document.getElementById('where');

    var IMAGE_HOLD = 2000;
    var ROW_HOLD = 900;        // per table row
    var TABLE_MAX = 9000;
    var SPOKEN = 'P,H1,H2,H3,H4,LI,BLOCKQUOTE'.split(',');

    // Chrome cuts off utterances longer than about fifteen seconds, so
    // everything is spoken in sentence sized pieces.
    function pieces(text) {
      var out = [], buf = '';
      text.replace(/\s+/g, ' ').trim().split(/(?<=[.!?])\s+/).forEach(function (s) {
        if ((buf + ' ' + s).trim().length > 220) { if (buf) out.push(buf.trim()); buf = s; }
        else { buf = (buf + ' ' + s).trim(); }
      });
      if (buf) out.push(buf);
      return out;
    }

    // One flat list of steps: speak this, or hold on that.
    var steps = [];
    Array.prototype.forEach.call(read.querySelectorAll('*'), function (el) {
      if (el.closest('table') && el.tagName !== 'TABLE') return;
      if (el.tagName === 'IMG') { steps.push({ el: el, hold: IMAGE_HOLD }); return; }
      if (el.tagName === 'TABLE') {
        var rows = el.querySelectorAll('tr').length;
        steps.push({ el: el, hold: Math.min(TABLE_MAX, rows * ROW_HOLD) });
        return;
      }
      if (SPOKEN.indexOf(el.tagName) === -1) return;
      if (el.querySelector('p, li, blockquote')) return;   // containers, not lines
      var text = el.textContent.trim();
      if (text) steps.push({ el: el, say: pieces(text) });
    });

    var at = -1, playing = false, timer = null;

    function voice() {
      var vs = synth.getVoices() || [];
      var want = ['Google UK English Male', 'Microsoft Ryan', 'Daniel', 'Microsoft George'];
      for (var i = 0; i < want.length; i++) {
        for (var j = 0; j < vs.length; j++) {
          if (vs[j].name.indexOf(want[i]) === 0) return vs[j];
        }
      }
      return vs.filter(function (v) { return /^en/i.test(v.lang); })[0] || null;
    }

    function mark(el) {
      var old = read.querySelector('.speaking');
      if (old) old.classList.remove('speaking');
      el.classList.add('speaking');
      el.scrollIntoView({ behavior: 'smooth', block: 'center' });
      where.textContent = (at + 1) + ' of ' + steps.length;
    }

    function run() {
      if (!playing) return;
      at++;
      if (at >= steps.length) return halt();
      var step = steps[at];
      mark(step.el);
      if (step.hold) { timer = setTimeout(run, step.hold); return; }
      sayAll(step.say.slice());
    }

    // Never chain on onend alone. If a browser loses that event, and some do,
    // the whole reading freezes with no way out. Every utterance therefore
    // carries a watchdog set a little past how long it ought to take, and
    // whichever fires first moves us on. Only once, hence the guard.
    var guard = null;

    function sayAll(queue) {
      if (!playing) return;
      if (!queue.length) return run();
      var text = queue.shift();
      var u = new SpeechSynthesisUtterance(text);
      var v = voice();
      if (v) { u.voice = v; u.lang = v.lang; }
      u.rate = 0.95;
      u.pitch = 0.9;

      var done = false;
      function next() {
        if (done) return;
        done = true;
        clearTimeout(guard);
        sayAll(queue);
      }
      u.onend = next;
      u.onerror = next;

      // Roughly fourteen characters a second at this rate, plus four seconds
      // of slack, and a floor so very short lines are not cut off.
      var expected = Math.max(2500, (text.length / 14) * 1000 / u.rate + 4000);
      guard = setTimeout(function () { synth.cancel(); next(); }, expected);

      synth.speak(u);
    }

    // Chrome stops speaking after about fifteen seconds unless it is nudged.
    setInterval(function () {
      if (playing && synth.speaking && !synth.paused) { synth.pause(); synth.resume(); }
    }, 9000);

    function halt() {
      playing = false;
      clearTimeout(timer);
      clearTimeout(guard);
      synth.cancel();
      var old = read.querySelector('.speaking');
      if (old) old.classList.remove('speaking');
      playBtn.textContent = 'Listen';
      stopBtn.hidden = true;
      where.textContent = '';
      at = -1;
    }

    playBtn.addEventListener('click', function () {
      if (playing) {                       // pause
        playing = false;
        clearTimeout(timer);
        clearTimeout(guard);
        synth.cancel();
        playBtn.textContent = 'Resume';
        at--;                              // repeat the block we interrupted
        return;
      }
      playing = true;
      playBtn.textContent = 'Pause';
      stopBtn.hidden = false;
      run();
    });

    stopBtn.addEventListener('click', halt);
    window.addEventListener('beforeunload', function () { synth.cancel(); });
    if (synth.onvoiceschanged !== undefined) synth.onvoiceschanged = function () {};
  })();
</script>

</body>
</html>
