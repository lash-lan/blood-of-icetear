---
import SectionLayout from '../../layouts/SectionLayout.astro';
import { HOSTS, TERRAIN, ROLES } from '../../data/mist-war.js';

// The board, the hosts and the fog are all built in the browser, because the
// whole game is one person's private view of a shared map and there is no
// server to keep a secret on. Everything this page knows about the rules
// comes from src/lib/mist-war.js, which does not draw anything.
const skills = [
  ['recruit', 'Recruit', 'Blunders about. Will walk into a blade.'],
  ['captain', 'Captain', 'Guards its Lord and takes trades that are worth taking.'],
  ['warlord', 'Warlord', 'Patient. Will wait in a wood for you to walk past it.'],
];
---
<SectionLayout
  title="The Mist War | Blood of Icetear"
  description="Chess under Akidna's fog. A rolled map, a drawn host, and up to five banners who can only see as far as their own eyes reach."
  theme="gallery"
  eyebrow="Blood of Icetear"
  heading="The Mist War"
  tagline="Akidna lies drowned beneath the northern sea, and her mist covers the only road between the continents. Five hosts walk into it."
  compact={true}
>
  <div class="wrap">

    <!-- ── setting the field ────────────────────────────────────────────── -->
    <section class="setup" id="setup">
      <h2>Call the hosts</h2>
      <p class="lede">
        Two to five banners. Give one to yourself and the rest to Captains, or
        sit several people round the same screen and the board will veil
        itself as it passes between you.
      </p>

      <ul class="hosts" id="hostList">
        {HOSTS.map((h, i) => (
          <li class="host" data-host={h.id} style={`--host:${h.colour};--ink:${h.ink}`}>
            <div class="host-id">
              <span class="host-pip"></span>
              <div>
                <strong>{h.name}</strong>
                <span class="host-seat">{h.seat}</span>
              </div>
            </div>
            <p class="host-blurb">{h.blurb}</p>
            <p class="host-unique">
              <span class="host-glyph">{h.unique.glyph}</span>
              <span><strong>{h.unique.rank}.</strong> {h.unique.note}</span>
            </p>
            <div class="host-pick" role="radiogroup" aria-label={`Who plays ${h.name}`}>
              <button type="button" data-seatkind="off" class="on">Empty</button>
              <button type="button" data-seatkind="human">Player</button>
              {skills.map(([id, name, note]) => (
                <button type="button" data-seatkind={id} title={note}>{name}</button>
              ))}
            </div>
          </li>
        ))}
      </ul>

      <div class="setup-foot">
        <label class="seedbox">
          <span>Seed</span>
          <input type="text" id="seed" inputmode="numeric" placeholder="roll one" />
          <small>The same seed rolls the same ground and the same hosts. Leave it empty for a new war.</small>
        </label>
        <button type="button" id="start" class="go">March on this screen</button>
      </div>
      <p class="warn" id="setupWarn" hidden>Two banners at least, or there is nobody to fight.</p>

      <div class="apart">
        <h2>Or fight it from your own phones</h2>
        <p class="lede">
          Open a war and the board is kept on the server instead of on this
          screen, so everyone plays on their own device and nobody can see
          anyone else's fog. Mark a banner <strong>Player</strong> for each
          person joining. The first belongs to you, the rest are left open for
          whoever has the code.
        </p>
        <div class="apart-row">
          <button type="button" id="open" class="go">Open a war</button>
          <span class="or">or</span>
          <label class="codebox">
            <span>Join with a code</span>
            <input type="text" id="joinCode" maxlength="6" placeholder="ABCD" autocomplete="off" />
          </label>
          <button type="button" id="joinGo" class="ghost">Join</button>
        </div>
        <p class="warn" id="netWarn" hidden></p>

        <div class="lobby" id="lobby" hidden>
          <p class="lobby-eyebrow">The war is open. Send this to the others.</p>
          <strong class="lobby-code" id="lobbyCode">—</strong>
          <button type="button" class="ghost" id="copyLink">Copy the link</button>
          <ul class="lobby-seats" id="lobbySeats"></ul>
          <p class="dim small" id="lobbyNote">Waiting for the banners to be taken.</p>
        </div>
      </div>
    </section>

    <!-- ── the war ──────────────────────────────────────────────────────── -->
    <section class="war" id="war" hidden>
      <div class="banner" id="banner">
        <span class="banner-pip" id="bannerPip"></span>
        <div class="banner-who">
          <strong id="bannerName">—</strong>
          <span id="bannerNote">—</span>
        </div>
        <div class="banner-stats" id="bannerStats"></div>
        <button type="button" id="endTurn" class="ghost">End turn</button>
      </div>

      <div class="field">
        <div class="boardwrap">
          <div class="board" id="board" role="grid" aria-label="The bridge"></div>
          <div class="veil" id="veil" hidden>
            <p class="veil-eyebrow">The mist closes</p>
            <strong id="veilName">—</strong>
            <p class="veil-note">Hand the board on. Nobody else should be looking at it.</p>
            <button type="button" id="veilGo" class="go">I have it</button>
          </div>
          <div class="over" id="over" hidden>
            <p class="over-eyebrow">The bridge is held</p>
            <strong id="overName">—</strong>
            <p id="overNote"></p>
            <div class="over-btns">
              <button type="button" id="again" class="go">March again</button>
              <button type="button" id="back" class="ghost">Change the hosts</button>
            </div>
          </div>
        </div>

        <aside class="side">
          <div class="panel" id="sel">
            <h3>Nothing chosen</h3>
            <p class="dim">Touch one of your own pieces to see where it may go.</p>
          </div>

          <div class="panel roster" id="roster"></div>

          <div class="panel">
            <h3>The ground</h3>
            <ul class="legend">
              {Object.values(TERRAIN).map((t) => (
                <li>
                  <span class={`sw sw-${t.id}`}>{t.glyph}</span>
                  <span><strong>{t.name}.</strong> {t.note}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="panel">
            <h3>The word from the field</h3>
            <ol class="log" id="log"></ol>
          </div>
        </aside>
      </div>

      <details class="rules">
        <summary>How it is played</summary>
        <div class="rules-body">
          <p>
            A turn is one move. Hold two shrines at the start of your turn and
            it is two. Take a piece by moving on to it. Lose your Lord and your
            host leaves the field, every piece with it. The last Lord standing
            holds the bridge.
          </p>
          <p>
            <strong>You see only what your own pieces can see.</strong> Ground
            you have walked stays on the map as memory, but what is standing on
            it now does not. A wood or a mistwell blocks the eye, and a piece
            standing inside one sees a single pace in any direction. A crag
            stops both the eye and the foot.
          </p>
          <p>
            A piece that slides must stop when it enters a wood or a mistwell,
            because undergrowth and pooled fog break a charge. The Behemoth
            does not care.
          </p>
          <ul class="pieces">
            {Object.values(ROLES).map((r) => (
              <li><span class="pg">{r.glyph}</span> <strong>{r.rank}.</strong> {r.note}</li>
            ))}
          </ul>
          <p class="dim">
            Every host also fields one piece that only it can field, drawn from
            the same bag as the rest, so you may not get it at all.
          </p>
        </div>
      </details>
    </section>
  </div>
</SectionLayout>

<script>
  import {
    createGame, legalMoves, applyMove, endTurn, visibleTo, piecesVisibleTo,
    shrinesHeld, livingOf, rankName, idx,
    TERRAIN, ROLES, HOSTS, hostById,
  } from '../../lib/mist-war.js';
  import { chooseMove } from '../../lib/mist-war-ai.js';

  const $ = (id) => document.getElementById(id);
  const board = $('board');

  // Two ways to play the same game. On this screen the whole board lives in
  // this tab and the fog is kept by not drawing it. Across phones the board
  // lives on the server and this tab is only ever sent what it may see, so
  // there is nothing to peek at even in the network traffic.
  let mode = 'local';          // 'local' | 'net'
  let game = null;             // the whole board, local play only
  let view = null;             // the fogged view, net play only
  let net = null;              // { code, token, seat, version }
  let poll = null;

  let selected = null;
  let viewSeat = null;
  let veiled = false;
  let thinking = false;

  /** Whichever object the rules can be asked about right now. */
  const S = () => (mode === 'net' ? view : game);

  // ── setting the field ─────────────────────────────────────────────────────
  const picks = new Map(HOSTS.map((h, i) => [h.id, i < 3 ? (i === 0 ? 'human' : 'captain') : 'off']));

  function paintPicks() {
    for (const li of document.querySelectorAll('.host')) {
      const id = li.dataset.host;
      li.classList.toggle('is-on', picks.get(id) !== 'off');
      for (const b of li.querySelectorAll('[data-seatkind]')) {
        b.classList.toggle('on', b.dataset.seatkind === picks.get(id));
      }
    }
  }
  $('hostList').addEventListener('click', (e) => {
    const b = e.target.closest('[data-seatkind]');
    if (!b) return;
    picks.set(b.closest('.host').dataset.host, b.dataset.seatkind);
    paintPicks();
  });
  paintPicks();

  const chosenSeats = () => HOSTS.filter((h) => picks.get(h.id) !== 'off');

  $('start').addEventListener('click', () => {
    const seats = chosenSeats().map((h) => {
      const kind = picks.get(h.id);
      return {
        hostId: h.id,
        kind: kind === 'human' ? 'human' : 'captain',
        skill: kind === 'human' ? null : kind,
        name: h.short,
      };
    });
    if (seats.length < 2) { $('setupWarn').hidden = false; return; }
    $('setupWarn').hidden = true;
    const raw = $('seed').value.trim();
    const seed = raw ? ([...raw].reduce((n, c) => (n * 31 + c.charCodeAt(0)) >>> 0, 7)) : Math.floor(Math.random() * 1e9);
    beginLocal(seats, seed);
  });

  function beginLocal(seats, seed) {
    mode = 'local';
    stopPolling();
    game = createGame(seats, seed);
    game.seats.forEach((s, i) => { s.skill = seats[i].skill; });
    selected = null;
    $('setup').hidden = true;
    $('war').hidden = false;
    $('over').hidden = true;
    $('seed').value = String(seed);
    buildBoard(game.size);
    openTurn();
  }

  // ── across phones ─────────────────────────────────────────────────────────
  const warn = (msg) => { const el = $('netWarn'); el.textContent = msg; el.hidden = !msg; };

  async function api(body) {
    const res = await fetch('/api/mist-war', {
      method: 'POST', headers: { 'content-type': 'application/json' },
      body: JSON.stringify(body),
    });
    return res.json();
  }

  $('open').addEventListener('click', async () => {
    const chosen = chosenSeats();
    if (chosen.length < 2) { warn('Two banners at least, or there is nobody to fight.'); return; }
    // The first Player seat is yours. Every other Player seat is left open
    // for whoever you send the code to.
    let claimed = false;
    const seats = chosen.map((h) => {
      const k = picks.get(h.id);
      if (k !== 'human') return { hostId: h.id, kind: k };
      if (!claimed) { claimed = true; return { hostId: h.id, kind: 'you' }; }
      return { hostId: h.id, kind: 'open' };
    });
    if (!claimed) { warn('Mark one banner as Player so you have something to hold.'); return; }
    warn('');
    $('open').disabled = true;
    const out = await api({ action: 'create', seats });
    $('open').disabled = false;
    if (out.error) return warn(out.error);
    net = { code: out.code, token: out.token, seat: out.seat, version: 0 };
    showLobby();
    startPolling();
  });

  $('joinGo').addEventListener('click', async () => {
    const code = $('joinCode').value.trim().toUpperCase();
    if (!code) return warn('A code first.');
    warn('');
    const out = await api({ action: 'join', code });
    if (out.error) return warn(out.error);
    net = { code: out.code, token: out.token, seat: out.seat, version: 0 };
    showLobby();
    startPolling();
  });

  $('copyLink').addEventListener('click', () => {
    const link = `${location.origin}${location.pathname}?war=${net.code}`;
    navigator.clipboard?.writeText(link);
    $('copyLink').textContent = 'Copied';
    setTimeout(() => { $('copyLink').textContent = 'Copy the link'; }, 1600);
  });

  function showLobby() {
    $('lobby').hidden = false;
    $('lobbyCode').textContent = net.code;
  }

  function paintLobby(info) {
    $('lobbySeats').innerHTML = info.lobby.map((s) => {
      const h = hostById[s.hostId];
      const who = s.kind === 'open' ? 'open' : s.kind === 'captain' ? (s.skill || 'captain') : 'held';
      const you = s.i === info.you ? ' (you)' : '';
      return `<li><span class="pip" style="background:${h.colour}"></span>
        <span>${h.name}${you}</span><span class="st">${who}</span></li>`;
    }).join('');
    $('lobbyNote').textContent = info.started
      ? 'Every banner is held. The war has begun.'
      : 'Waiting for the banners to be taken.';
  }

  function startPolling() {
    stopPolling();
    const tick = async () => {
      if (!net) return;
      let info;
      try {
        const res = await fetch(`/api/mist-war?code=${net.code}&token=${net.token}`, { cache: 'no-store' });
        info = await res.json();
      } catch { return; }
      if (info.error) return warn(info.error);
      if (!info.started) { paintLobby(info); return; }

      if (mode !== 'net') {
        mode = 'net';
        $('setup').hidden = true;
        $('war').hidden = false;
        $('over').hidden = true;
      }
      if (info.version !== net.version || !view) {
        net.version = info.version;
        view = info.view;
        viewSeat = info.you;
        if (!board.children.length || board.children.length !== view.size * view.size) buildBoard(view.size);
        if (selected && !view.pieces.some((p) => p.id === selected)) selected = null;
        render();
        if (view.over) showOver();
      }
    };
    tick();
    poll = setInterval(tick, 1700);
  }
  function stopPolling() { if (poll) clearInterval(poll); poll = null; }

  // A link with ?war=CODE walks straight into the joining step.
  const fromLink = new URLSearchParams(location.search).get('war');
  if (fromLink) { $('joinCode').value = fromLink.toUpperCase(); $('lobby').hidden = true; }

  // ── the board ─────────────────────────────────────────────────────────────
  function buildBoard(n) {
    board.style.setProperty('--n', n);
    board.innerHTML = '';
    for (let y = 0; y < n; y++) {
      for (let x = 0; x < n; x++) {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'tile';
        b.dataset.x = x; b.dataset.y = y;
        board.appendChild(b);
      }
    }
  }

  const humanSeats = () => game.seats.filter((s) => s.kind === 'human' && s.alive);

  /** Whose eyes we are looking through. Null means nobody is hiding anything. */
  function whoSees() {
    if (mode === 'net') return view ? view.you : null;
    if (game.over) return null;
    const cur = game.seats[game.turn];
    if (cur && cur.kind === 'human') return cur.i;
    const humans = humanSeats();
    if (!humans.length) return null;
    return viewSeat !== null && game.seats[viewSeat] && game.seats[viewSeat].alive
      ? viewSeat : humans[0].i;
  }

  /** The fog, worked out locally or taken from the server. */
  function fogOf(st) {
    if (mode === 'net') return { lit: view.lit, known: view.known, shown: view.pieces };
    viewSeat = whoSees();
    if (viewSeat === null) {
      const all = new Uint8Array(st.size * st.size).fill(1);
      return { lit: all, known: all, shown: st.pieces.filter((p) => p.alive) };
    }
    const lit = visibleTo(st, viewSeat);
    return { lit, known: st.seats[viewSeat].seen, shown: piecesVisibleTo(st, viewSeat, lit) };
  }

  function render() {
    const st = S();
    if (!st) return;
    const { lit, known, shown } = fogOf(st);
    const byTile = new Map(shown.map((p) => [idx(st.size, p.x, p.y), p]));

    const sel = selected ? shown.find((p) => p.id === selected) : null;
    const mine = sel && sel.seat === (mode === 'net' ? view.you : viewSeat);
    const moves = mine ? legalMoves(st, sel) : [];
    const moveSet = new Map(moves.map((m) => [idx(st.size, m.x, m.y), m]));

    let i = 0;
    for (let y = 0; y < st.size; y++) {
      for (let x = 0; x < st.size; x++) {
        const k = idx(st.size, x, y);
        const el = board.children[i++];
        if (!el) continue;
        const canSee = !!lit[k];
        const seen = !!known[k];
        const ground = st.terrain[k];
        const piece = canSee ? byTile.get(k) : null;

        el.className = 'tile'
          + (seen ? ` g-${ground}` : ' g-dark')
          + (canSee ? ' lit' : seen ? ' memory' : '')
          + (piece ? ' has' : '')
          + (sel && piece && sel.id === piece.id ? ' sel' : '')
          + (moveSet.has(k) ? (moveSet.get(k).takes ? ' hit' : ' go') : '');

        if (piece) {
          const host = hostById[st.seats[piece.seat].hostId];
          el.innerHTML = `<span class="pc" style="--host:${host.colour}">${piece.glyph}</span>`;
          el.setAttribute('aria-label',
            `${x + 1},${y + 1}. ${host.short} ${rankName(st.seats[piece.seat], piece)}.`);
        } else {
          el.innerHTML = seen ? `<span class="gr">${TERRAIN[ground].glyph}</span>` : '';
          el.setAttribute('aria-label',
            seen ? `${x + 1},${y + 1}. ${TERRAIN[ground].name}.` : `${x + 1},${y + 1}. Unseen.`);
        }
      }
    }
    paintBanner(st);
    paintRoster(st);
    paintSelection(st, sel);
    paintLog(st);
  }

  function paintBanner(st) {
    const seat = st.seats[st.turn];
    const host = hostById[seat.hostId];
    $('bannerPip').style.background = host.colour;
    $('bannerName').textContent = host.name;
    const yours = mode === 'net' ? st.turn === view.you : seat.kind === 'human';
    const shrines = mode === 'net' ? seat.shrines : shrinesHeld(st, seat.i);
    const standing = mode === 'net' ? seat.standing : livingOf(st, seat.i).length;
    $('bannerNote').textContent = st.over ? 'The war is over.'
      : yours ? (st.extraFor ? 'The Nightmare may ride again, or you may stop.'
                             : `Move ${seat.movesLeft === 2 ? 'twice' : 'once'}.`)
      : mode === 'net' ? 'Waiting on another banner.' : 'A Captain is thinking.';
    $('bannerStats').innerHTML = [
      `<span>Round ${st.round}</span>`,
      `<span>${standing} standing</span>`,
      `<span>${shrines} shrine${shrines === 1 ? '' : 's'}</span>`,
      mode === 'net' ? `<span>Code ${net.code}</span>` : '',
    ].join('');
    $('endTurn').hidden = !yours || !!st.over;
    document.querySelector('.banner').style.setProperty('--host', host.colour);
  }

  function paintRoster(st) {
    const rows = st.seats.map((s) => {
      const host = hostById[s.hostId];
      const n = mode === 'net' ? s.standing : livingOf(st, s.i).length;
      const you = mode === 'net' ? s.i === view.you : s.kind === 'human';
      return `<li class="${s.alive ? '' : 'out'} ${s.i === st.turn ? 'now' : ''}">
        <span class="pip" style="background:${host.colour}"></span>
        <span class="rn">${host.short}</span>
        <span class="rk">${mode === 'net' ? (you ? 'You' : s.kind === 'captain' ? 'Captain' : 'Player')
                                          : (s.kind === 'human' ? 'Player' : 'Captain')}</span>
        <span class="rc">${s.alive ? n : 'out'}</span>
      </li>`;
    }).join('');
    $('roster').innerHTML = `<h3>The banners</h3><ul class="rost">${rows}</ul>`;
  }

  function paintSelection(st, sel) {
    const box = $('sel');
    if (!sel) {
      box.innerHTML = '<h3>Nothing chosen</h3><p class="dim">Touch one of your own pieces to see where it may go.</p>';
      return;
    }
    const seat = st.seats[sel.seat];
    const host = hostById[seat.hostId];
    const def = sel.role === 'unique' ? host.unique : ROLES[sel.role];
    const traits = (sel.traits || []).length
      ? `<p class="trait">${sel.traits.map((t) => `<span>${t}</span>`).join('')}</p>` : '';
    box.innerHTML = `<h3 style="color:${host.colour}">${rankName(seat, sel)}</h3>
      <p class="dim">${def.note}</p>${traits}
      <p class="dim small">Sees ${sel.sight} ${sel.sight === 1 ? 'pace' : 'paces'} in clear ground.</p>`;
  }

  function paintLog(st) {
    $('log').innerHTML = (st.log || []).slice(0, 14)
      .map((l) => `<li><span>${l.round}</span>${l.line}</li>`).join('')
      || '<li class="dim">Nothing yet.</li>';
  }

  // ── taking a turn ─────────────────────────────────────────────────────────
  board.addEventListener('click', async (e) => {
    const t = e.target.closest('.tile');
    const st = S();
    if (!t || !st || st.over || veiled || thinking) return;
    const yours = mode === 'net' ? st.turn === view.you : st.seats[st.turn].kind === 'human';
    if (!yours) return;
    const x = +t.dataset.x, y = +t.dataset.y;
    const { shown } = fogOf(st);
    const sel = selected ? shown.find((p) => p.id === selected) : null;

    if (sel) {
      const m = legalMoves(st, sel).find((q) => q.x === x && q.y === y);
      if (m) {
        if (mode === 'net') {
          thinking = true;
          const out = await api({ action: 'move', code: net.code, token: net.token, pieceId: sel.id, x, y });
          thinking = false;
          if (out.error) { warn(out.error); return; }
          net.version = out.version; view = out.view; selected = view.extraFor || null;
          render();
          if (out.note) $('bannerNote').textContent = out.note;
          if (view.over) showOver();
        } else {
          applyMove(st, sel.id, x, y);
          selected = st.extraFor || null;
          render();
          afterMove();
        }
        return;
      }
    }
    const mineHere = shown.find((p) => p.x === x && p.y === y && p.seat === st.turn);
    selected = (mineHere && (!st.extraFor || st.extraFor === mineHere.id)) ? mineHere.id : null;
    render();
  });

  $('endTurn').addEventListener('click', async () => {
    const st = S();
    if (!st || st.over || thinking) return;
    if (mode === 'net') {
      thinking = true;
      const out = await api({ action: 'end', code: net.code, token: net.token });
      thinking = false;
      if (out.error) return warn(out.error);
      net.version = out.version; view = out.view; selected = null;
      render();
      if (view.over) showOver();
      return;
    }
    endTurn(st);
    selected = null;
    render();
    afterMove();
  });

  /** Local play only: finish, veil, or let a Captain think. */
  function afterMove() {
    if (game.over) return showOver();
    const seat = game.seats[game.turn];
    if (seat.kind === 'human') {
      if (humanSeats().length > 1 && seat.i !== viewSeat) raiseVeil(seat);
      else render();
      return;
    }
    runCaptain();
  }

  function runCaptain() {
    thinking = true;
    render();
    setTimeout(() => {
      if (!game || game.over) { thinking = false; return showOver(); }
      const seat = game.seats[game.turn];
      if (seat.kind === 'human') { thinking = false; return afterMove(); }
      const move = chooseMove(game, seat.i, seat.skill || 'captain');
      if (move) applyMove(game, move.piece.id, move.x, move.y);
      else endTurn(game);
      thinking = false;
      render();
      afterMove();
    }, 420);
  }

  function raiseVeil(seat) {
    veiled = true;
    $('veilName').textContent = hostById[seat.hostId].name;
    $('veil').hidden = false;
    board.classList.add('hidden-board');
  }
  $('veilGo').addEventListener('click', () => {
    veiled = false;
    $('veil').hidden = true;
    board.classList.remove('hidden-board');
    viewSeat = game.turn;
    selected = null;
    render();
  });

  function openTurn() {
    const seat = game.seats[game.turn];
    if (seat.kind === 'human') { viewSeat = seat.i; render(); }
    else { render(); runCaptain(); }
  }

  function showOver() {
    const st = S();
    render();
    const w = st.over.winner;
    $('overName').textContent = w === null ? 'Nobody' : hostById[st.seats[w].hostId].name;
    $('overNote').textContent = st.over.reason === 'limit'
      ? 'The turns ran out. The ground held decided it.'
      : w === null ? 'Every host went into the mist and none came out.'
      : 'The last Lord standing.';
    $('again').hidden = mode === 'net';
    $('over').hidden = false;
    if (mode === 'net') stopPolling();
  }

  $('again').addEventListener('click', () => {
    const seats = game.seats.map((s) => ({ hostId: s.hostId, kind: s.kind, skill: s.skill, name: s.name }));
    $('over').hidden = true;
    beginLocal(seats, Math.floor(Math.random() * 1e9));
  });
  $('back').addEventListener('click', () => {
    stopPolling();
    net = null; view = null; mode = 'local';
    $('over').hidden = true;
    $('war').hidden = true;
    $('setup').hidden = false;
    $('lobby').hidden = true;
    game = null;
  });
</script>

