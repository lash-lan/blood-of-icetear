---
import SectionLayout from '../../layouts/SectionLayout.astro';
import { BANNERS } from '../../lib/war-table.js';
---
<SectionLayout
  title="The War Table | Blood of Icetear"
  description="Chess, one against one, with Akidna's mist across the board. You see your own pieces and the squares they can reach. Everything else is fog."
  theme="gallery"
  eyebrow="Blood of Icetear"
  heading="The War Table"
  tagline="Ordinary chess, with one thing taken away. You can only see as far as your own pieces can reach."
  compact={true}
>
  <div class="wt">

    <!-- ── setting up ───────────────────────────────────────────────────── -->
    <section class="setup" id="setup">
      <div class="side-pick">
        <h2>Your banner</h2>
        <ul class="banners" id="mine">
          {BANNERS.map((b, i) => (
            <li>
              <button type="button" data-id={b.id} class={i === 1 ? 'on' : ''}
                      style={`--c:${b.colour};--ink:${b.ink}`}>
                <span class="pip"></span>
                <span class="bn">{b.short}</span>
              </button>
            </li>
          ))}
        </ul>
      </div>

      <div class="side-pick">
        <h2>Theirs</h2>
        <ul class="banners" id="theirs">
          {BANNERS.map((b, i) => (
            <li>
              <button type="button" data-id={b.id} class={i === 2 ? 'on' : ''}
                      style={`--c:${b.colour};--ink:${b.ink}`}>
                <span class="pip"></span>
                <span class="bn">{b.short}</span>
              </button>
            </li>
          ))}
        </ul>
      </div>

      <div class="side-pick">
        <h2>Who holds it</h2>
        <div class="opts" id="foe">
          <button type="button" data-foe="recruit">Recruit</button>
          <button type="button" data-foe="captain" class="on">Captain</button>
          <button type="button" data-foe="warlord">Warlord</button>
          <button type="button" data-foe="human">A second player, here</button>
        </div>
        <p class="hint" id="foeHint">Guards its King and takes what is worth taking.</p>
      </div>

      <button type="button" id="start" class="go">Sit down</button>
      <p class="warn" id="warn" hidden>Two different banners, please.</p>
    </section>

    <!-- ── the table ────────────────────────────────────────────────────── -->
    <section class="table" id="table" hidden>
      <div class="bar">
        <span class="bar-pip" id="barPip"></span>
        <div class="bar-who">
          <strong id="barName">—</strong>
          <span id="barNote">—</span>
        </div>
        <div class="bar-right">
          <button type="button" id="sound" class="ghost" aria-pressed="true">Sound on</button>
          <button type="button" id="leave" class="ghost">Leave the table</button>
        </div>
      </div>

      <div class="field">
        <div class="boardwrap">
          <div class="stage" id="stage">
            <div class="board" id="board" style="--n:9">
              <div class="ground"></div>
              <div class="squares" id="squares"></div>
              <div class="pieces" id="piecelayer"></div>
              <div class="files" id="files"></div>
              <div class="ranks" id="ranks"></div>
            </div>
          </div>
          <div class="viewbar">
            <span class="vhint">Drag to look around. Scroll or pinch to come closer.</span>
            <button type="button" id="flat" class="ghost">Flat</button>
            <button type="button" id="resetView" class="ghost">Reset view</button>
          </div>

          <div class="veil" id="veil" hidden>
            <p class="eyebrow">The mist closes</p>
            <strong id="veilName">—</strong>
            <p class="dim">Hand the table over. Nobody else should be looking.</p>
            <button type="button" id="veilGo" class="go">I have it</button>
          </div>
          <div class="over" id="over" hidden>
            <p class="eyebrow" id="overWhy">The King is taken</p>
            <strong id="overName">—</strong>
            <div class="over-btns">
              <button type="button" id="again" class="go">Again</button>
              <button type="button" id="back" class="ghost">Change banners</button>
            </div>
          </div>
        </div>

        <aside class="side">
          <div class="panel" id="taken"></div>
          <div class="panel">
            <h3>What the mist does</h3>
            <p class="dim">
              You see your own pieces and every square one of them could move
              to. Nothing else. There is no check and no warning, so a King
              can be walked into danger and taken. <strong>Taking the King
              wins the table.</strong>
            </p>
            <p class="dim">Everything else is chess, castling and en passant included.</p>
          </div>
          <div class="panel">
            <h3>The word from the field</h3>
            <ol class="log" id="log"></ol>
          </div>
        </aside>
      </div>
    </section>
  </div>
</SectionLayout>

<script>
  import {
    newGame, movesFrom, allMoves, play, visible, sensed, material,
    BANNERS, bannerById, GLYPH, FULL, VALUE, sq, nameOf, N,
  } from '../../lib/war-table.js';
  import { chooseMove } from '../../lib/war-table-ai.js';

  const $ = (id) => document.getElementById(id);

  // Painted pieces, listed one at a time as they are made. Anything not in
  // here falls back to its chess glyph, so a half finished set still plays.
  const PAINTED = new Set([
    'rangers-k',
  ]);
  const faceOf = (bannerId, type) =>
    PAINTED.has(`${bannerId}-${type}`) ? `/images/chess/${bannerId}-${type}.webp` : null;

  // Below this, a painting is a smudge and a glyph is a shape, so the board
  // goes back to glyphs on its own. Nine squares across a phone is about
  // thirty eight pixels each, which no painted piece survives.
  const ART_FLOOR = 58;
  const squarePx = () => {
    const b = document.querySelector('.board');
    return b ? b.clientWidth / N : 0;
  };

  // Where the eye is. The board is a real plane tilted away from you, and
  // everything standing on it is turned back to face you, which is the whole
  // trick: one rotation out, one rotation back.
  const cam = { spin: 0, tilt: 54, zoom: 1, panX: 0, panY: 0 };
  const DEFAULT_CAM = { ...cam };

  let g = null;
  let foe = 'captain';
  let mine = BANNERS[1].id, theirs = BANNERS[2].id;
  let selected = null;
  let viewSide = 'w';
  let busy = false;
  let veiled = false;
  const els = new Map();        // piece id -> its element, so it can be moved

  // ── setting up ────────────────────────────────────────────────────────────
  const HINTS = {
    recruit: 'Plays quickly and badly. Will leave pieces where they can be taken.',
    captain: 'Guards its King and takes what is worth taking.',
    warlord: 'Looks a move ahead, as far as the mist lets anyone look.',
    human: 'Two of you on this screen. The board veils itself as it passes over.',
  };
  function pickFrom(listId, set) {
    $(listId).addEventListener('click', (e) => {
      const b = e.target.closest('[data-id]');
      if (!b) return;
      for (const x of $(listId).querySelectorAll('[data-id]')) x.classList.toggle('on', x === b);
      set(b.dataset.id);
    });
  }
  pickFrom('mine', (v) => { mine = v; });
  pickFrom('theirs', (v) => { theirs = v; });
  $('foe').addEventListener('click', (e) => {
    const b = e.target.closest('[data-foe]');
    if (!b) return;
    for (const x of $('foe').querySelectorAll('[data-foe]')) x.classList.toggle('on', x === b);
    foe = b.dataset.foe;
    $('foeHint').textContent = HINTS[foe];
  });

  $('start').addEventListener('click', () => {
    if (mine === theirs) { $('warn').hidden = false; return; }
    $('warn').hidden = true;
    begin();
  });

  function begin() {
    g = newGame(mine, theirs);
    selected = null; viewSide = 'w'; veiled = false; busy = false;
    $('setup').hidden = true;
    $('table').hidden = false;
    $('over').hidden = true;
    buildBoard();
    Object.assign(cam, DEFAULT_CAM);
    applyCamera();
    draw(true);
  }

  // ── the board ─────────────────────────────────────────────────────────────
  /** Push the camera on to the board, and turn every piece back to face it. */
  function applyCamera() {
    const b = document.querySelector('.board');
    if (!b) return;
    b.style.transform =
      `translate(${cam.panX}px, ${cam.panY}px) scale(${cam.zoom})`
      + ` rotateX(${cam.tilt}deg) rotateZ(${cam.spin}deg)`;
    // Every piece is counter rotated in the opposite order, which is what
    // keeps it standing upright however the board is turned.
    const stand = `rotateZ(${-cam.spin}deg) rotateX(${-cam.tilt}deg)`;
    document.querySelector('.pieces')?.style.setProperty('--stand', stand);
    for (const el of document.querySelectorAll('.pce')) {
      el.style.transform = `${el.dataset.place || ''} ${stand}`;
    }
    // The letters and numbers lie on the ground, so they turn with it, but
    // they are mirrored back the right way up when you look from behind.
    const flipped = Math.abs(((cam.spin % 360) + 360) % 360 - 180) < 90;
    document.querySelector('.board')?.classList.toggle('behind', flipped);
  }

  function buildBoard() {
    const squares = $('squares');
    document.querySelector('.board').style.setProperty('--n', N);
    squares.innerHTML = '';
    for (let i = 0; i < N * N; i++) {
      const d = document.createElement('button');
      d.type = 'button';
      d.className = 'sqr ' + (((i % N) + Math.floor(i / N)) % 2 ? 'dk' : 'lt');
      d.dataset.i = i;
      d.setAttribute('aria-label', nameOf(i));
      squares.appendChild(d);
    }
    $('files').innerHTML = [...'abcdefghi'].slice(0, N).map((f) => `<span>${f}</span>`).join('');
    $('ranks').innerHTML = Array.from({ length: N }, (_, i) => N - i).map((r) => `<span>${r}</span>`).join('');
    $('piecelayer').innerHTML = '';
    els.clear();
  }

  /** Draw, moving the pieces that are already on the table rather than
   *  rebuilding them, which is what lets a move slide instead of blink. */
  function draw(hard = false) {
    const seen = visible(g, viewSide);
    // Two squares out you can feel something without being able to name it.
    const felt = viewSide ? sensed(g, viewSide) : null;
    const squares = $('squares');
    const moves = selected !== null ? movesFrom(g, selected) : [];
    const dots = new Map(moves.map((m) => [m.to, m]));

    for (let i = 0; i < N * N; i++) {
      const el = squares.children[i];
      el.classList.toggle('fog', !seen[i] && !g.over);
      el.classList.toggle('go', dots.has(i) && !dots.get(i).takes);
      el.classList.toggle('hit', dots.has(i) && !!dots.get(i).takes);
      el.classList.toggle('from', i === selected);
    }

    const alive = new Set();
    const bigEnough = squarePx() >= ART_FLOOR;
    for (let i = 0; i < N * N; i++) {
      const p = g.board[i];
      if (!p) continue;
      const known = g.over || seen[i] || p.side === viewSide;
      const shape = !known && felt && felt[i] && p.side !== viewSide;
      if (!known && !shape) continue;
      alive.add(p.id);
      let el = els.get(p.id);
      const bannerId = g.banners[p.side];
      if (!el) {
        el = document.createElement('div');
        el.className = 'pce';
        els.set(p.id, el);
        $('piecelayer').appendChild(el);
        el.style.transition = hard ? 'none' : '';
        requestAnimationFrame(() => { el.style.transition = ''; });
      }
      const b = bannerById[bannerId];
      if (shape) {
        // A shape, and nothing else. No banner, no rank, no colour, because
        // none of that is yours to know yet.
        el.innerHTML = '<span class="shade"></span>';
        el.classList.add('is-shade');
        el.classList.remove('art');
        el.removeAttribute('title');
        el.dataset.place = `translate(${(i % N) * 100}%, ${Math.floor(i / N) * 100}%)`;
        el.style.transform = `${el.dataset.place} rotateZ(${-cam.spin}deg) rotateX(${-cam.tilt}deg)`;
        el.setAttribute('aria-label', `${nameOf(i)}. Something is there.`);
        continue;
      }
      el.classList.remove('is-shade');
      const art = bigEnough ? faceOf(bannerId, p.type) : null;
      // The glow sits behind every piece, painted or not. With art it is the
      // only thing keeping two dark armies apart at a glance.
      el.innerHTML = (art
        ? `<img src="${art}" alt="" draggable="false" />`
        : `<span class="gl">${GLYPH[p.type]}</span>`);
      el.classList.toggle('art', !!art);
      el.style.setProperty('--c', b.colour);
      el.dataset.side = p.side;
      el.dataset.place = `translate(${(i % N) * 100}%, ${Math.floor(i / N) * 100}%)`;
      el.style.transform = `${el.dataset.place} rotateZ(${-cam.spin}deg) rotateX(${-cam.tilt}deg)`;
      el.title = `${b.short} ${b.ranks[p.type]}`;
    }
    // Anything no longer on the table, or no longer visible, leaves.
    for (const [id, el] of els) {
      if (alive.has(id)) continue;
      el.classList.add('gone');
      els.delete(id);
      setTimeout(() => el.remove(), 240);
    }
    paintBar();
    paintTaken();
    paintLog();
  }

  function paintBar() {
    const b = bannerById[g.banners[g.turn]];
    $('barPip').style.background = b.colour;
    $('barName').textContent = b.name;
    const yours = g.turn === 'w' || foe === 'human';
    $('barNote').textContent = g.over ? 'The table is settled.'
      : yours ? `Move ${g.moves + 1}. ${selected !== null ? 'Where to?' : 'Choose a piece.'}`
      : 'The Captain is thinking.';
    document.querySelector('.bar').style.setProperty('--c', b.colour);
  }

  function paintTaken() {
    const rows = ['w', 'b'].map((side) => {
      const b = bannerById[g.banners[side]];
      const lost = g.history.filter((h) => h.takenType && h.side !== side)
        .map((h) => GLYPH[h.takenType]).join(' ');
      const score = material(g, side);
      return `<li><span class="pip" style="background:${b.colour}"></span>
        <span class="tn">${b.short}</span>
        <span class="tg" style="color:${b.colour}">${lost || '—'}</span>
        <span class="ts">${score.toFixed(1)}</span></li>`;
    }).join('');
    $('taken').innerHTML = `<h3>Lost from the field</h3><ul class="tk">${rows}</ul>`;
  }

  function paintLog() {
    $('log').innerHTML = (g.log || []).slice(0, 12)
      .map((l) => `<li><span>${l.n}</span>${l.line}</li>`).join('')
      || '<li class="dim">Nothing yet.</li>';
  }

  // ── sound ─────────────────────────────────────────────────────────────────
  // Made on the spot rather than loaded, so there are no files to ship and
  // nothing to wait for on the first move.
  let ac = null, soundOn = true;
  const audio = () => (ac ||= new (window.AudioContext || window.webkitAudioContext)());
  function thunk({ freq = 150, dur = 0.14, kind = 'sine', gain = 0.22, noise = 0 } = {}) {
    if (!soundOn) return;
    try {
      const c = audio();
      const t = c.currentTime;
      const g1 = c.createGain();
      g1.gain.setValueAtTime(gain, t);
      g1.gain.exponentialRampToValueAtTime(0.0008, t + dur);
      g1.connect(c.destination);
      const o = c.createOscillator();
      o.type = kind; o.frequency.setValueAtTime(freq, t);
      o.frequency.exponentialRampToValueAtTime(freq * 0.6, t + dur);
      o.connect(g1); o.start(t); o.stop(t + dur);
      if (noise) {
        const buf = c.createBuffer(1, c.sampleRate * dur, c.sampleRate);
        const d = buf.getChannelData(0);
        for (let i = 0; i < d.length; i++) d[i] = (Math.random() * 2 - 1) * (1 - i / d.length);
        const n = c.createBufferSource(); n.buffer = buf;
        const ng = c.createGain(); ng.gain.value = noise;
        const f = c.createBiquadFilter(); f.type = 'bandpass'; f.frequency.value = 1800;
        n.connect(f); f.connect(ng); ng.connect(c.destination); n.start(t);
      }
    } catch {}
  }
  const sfx = {
    move: () => thunk({ freq: 190, dur: 0.11, gain: 0.16, noise: 0.05 }),
    take: () => thunk({ freq: 110, dur: 0.22, kind: 'triangle', gain: 0.3, noise: 0.22 }),
    castle: () => { thunk({ freq: 180, dur: 0.1, gain: 0.14 }); setTimeout(() => thunk({ freq: 150, dur: 0.12, gain: 0.14 }), 110); },
    end: () => { thunk({ freq: 90, dur: 0.9, kind: 'sine', gain: 0.26 }); setTimeout(() => thunk({ freq: 60, dur: 1.2, gain: 0.2 }), 180); },
  };
  $('sound').addEventListener('click', () => {
    soundOn = !soundOn;
    $('sound').textContent = soundOn ? 'Sound on' : 'Sound off';
    $('sound').setAttribute('aria-pressed', String(soundOn));
  });

  // ── taking a turn ─────────────────────────────────────────────────────────
  // Dragging the board turns it. A drag that barely moves is a tap, so the
  // same pointer does both without a modifier key.
  const stage = $('stage');
  let drag = null;
  let dragged = false;
  const pointers = new Map();
  let pinch = 0;

  stage.addEventListener('pointerdown', (e) => {
    pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
    if (pointers.size === 2) {
      const [a, b] = [...pointers.values()];
      pinch = Math.hypot(a.x - b.x, a.y - b.y);
      drag = null;
      return;
    }
    drag = { x: e.clientX, y: e.clientY, spin: cam.spin, tilt: cam.tilt,
             panX: cam.panX, panY: cam.panY, pan: e.shiftKey || e.button === 2 };
    dragged = false;
  });

  stage.addEventListener('pointermove', (e) => {
    if (pointers.has(e.pointerId)) pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
    if (pointers.size === 2) {
      const [a, b] = [...pointers.values()];
      const d = Math.hypot(a.x - b.x, a.y - b.y);
      if (pinch) { cam.zoom = clamp(cam.zoom * (d / pinch), 0.55, 2.6); applyCamera(); }
      pinch = d;
      dragged = true;
      return;
    }
    if (!drag) return;
    const dx = e.clientX - drag.x, dy = e.clientY - drag.y;
    if (Math.abs(dx) + Math.abs(dy) > 6) dragged = true;
    if (drag.pan) {
      cam.panX = drag.panX + dx;
      cam.panY = drag.panY + dy;
    } else {
      cam.spin = drag.spin + dx * 0.4;
      cam.tilt = clamp(drag.tilt + dy * 0.3, 8, 78);
    }
    applyCamera();
  });

  const letGo = (e) => { pointers.delete(e.pointerId); if (pointers.size < 2) pinch = 0; drag = null; };
  stage.addEventListener('pointerup', letGo);
  stage.addEventListener('pointercancel', letGo);
  stage.addEventListener('contextmenu', (e) => e.preventDefault());

  stage.addEventListener('wheel', (e) => {
    e.preventDefault();
    cam.zoom = clamp(cam.zoom * (e.deltaY > 0 ? 0.92 : 1.08), 0.55, 2.6);
    applyCamera();
  }, { passive: false });

  const clamp = (v, lo, hi) => Math.max(lo, Math.min(hi, v));

  $('resetView').addEventListener('click', () => {
    Object.assign(cam, DEFAULT_CAM); applyCamera();
  });
  $('flat').addEventListener('click', () => {
    Object.assign(cam, { spin: 0, tilt: 0, zoom: 1, panX: 0, panY: 0 }); applyCamera();
  });

  $('squares').addEventListener('click', (e) => {
    if (dragged) { dragged = false; return; }
    const t = e.target.closest('.sqr');
    if (!t || !g || g.over || busy || veiled) return;
    if (foe !== 'human' && g.turn !== 'w') return;
    const i = +t.dataset.i;

    if (selected !== null) {
      const m = movesFrom(g, selected).find((q) => q.to === i);
      if (m) return commit(selected, i);
    }
    const p = g.board[i];
    selected = (p && p.side === g.turn) ? i : null;
    draw();
  });

  function commit(from, to) {
    const ev = play(g, from, to, 'q');
    selected = null;
    if (!ev) return draw();
    if (ev.takenType) sfx.take();
    else if (ev.castle) sfx.castle();
    else sfx.move();
    if (foe === 'human') viewSide = g.turn;
    draw();
    if (g.over) return finish();
    if (foe === 'human') return passTo(g.turn);
    captainMoves();
  }

  function captainMoves() {
    busy = true;
    paintBar();
    setTimeout(() => {
      if (!g || g.over) { busy = false; return; }
      const m = chooseMove(g, 'b', foe);
      busy = false;
      if (!m) { g.over = { winner: 'w', reason: 'shut in' }; return finish(); }
      const ev = play(g, m.from, m.to, 'q');
      if (ev && ev.takenType) sfx.take();
      else if (ev && ev.castle) sfx.castle();
      else sfx.move();
      draw();
      if (g.over) finish();
    }, 520);
  }

  function passTo(side) {
    veiled = true;
    $('veilName').textContent = bannerById[g.banners[side]].name;
    $('veil').hidden = false;
    document.querySelector('.board').classList.add('blurred');
  }
  $('veilGo').addEventListener('click', () => {
    veiled = false;
    $('veil').hidden = true;
    document.querySelector('.board').classList.remove('blurred');
    draw();
  });

  function finish() {
    sfx.end();
    viewSide = null;
    draw();
    const w = g.over.winner;
    $('overWhy').textContent = g.over.reason === 'king' ? 'The King is taken'
      : g.over.reason === 'shut in' ? 'Nowhere left to go'
      : 'The mist outlasts them';
    $('overName').textContent = w ? bannerById[g.banners[w]].name : 'Neither side';
    $('over').hidden = false;
  }

  $('again').addEventListener('click', () => { $('over').hidden = true; begin(); });
  $('back').addEventListener('click', () => {
    $('over').hidden = true; $('table').hidden = true; $('setup').hidden = false; g = null;
  });
</script>

<style is:global>
  /* Global on purpose, and fenced behind .wt. The squares, the pieces and
     the log rows are all built in JavaScript, and Astro's scoped styles only
     ever match what is written in the template, so a scoped sheet would
     leave the board unpainted. */

  /* A class that sets display beats the hidden attribute, and most of this
     page is shown and hidden by that attribute, so it is spelled out once. */
  .wt [hidden] { display: none !important; }

  .wt{ max-width: 1100px; margin: 0 auto; padding: 0 1.25rem 5rem; }
  .wt h2{ font-size: .78rem; letter-spacing: .1em; text-transform: uppercase;
       color: var(--textDim); margin: 0 0 .5rem; }
  .wt h3{ font-size: .74rem; letter-spacing: .1em; text-transform: uppercase;
       color: var(--textDim); margin: 0 0 .5rem; }
  .wt .dim{ color: var(--textDim); line-height: 1.6; font-size: .86rem; margin: 0 0 .6rem; }
  .wt .eyebrow{ margin: 0; font-size: .74rem; letter-spacing: .18em;
             text-transform: uppercase; color: var(--textDim); }

  /* ── setup ── */
  .wt .setup{ border: 1px solid var(--line); background: var(--card); border-radius: 14px;
           padding: 1.4rem 1.5rem; display: grid; gap: 1.3rem; max-width: 46rem; }
  .wt .banners{ list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: .4rem; }
  .wt .banners button{ all: unset; cursor: pointer; display: flex; align-items: center; gap: .45rem;
                    padding: .4rem .75rem; border: 1px solid var(--line); border-radius: 8px;
                    color: var(--textDim); font-size: .88rem; }
  .wt .banners button:hover{ color: var(--textBright); }
